    <!-- Encoder values simulation
          <damping>40</damping>  
          <friction>0.6</friction>
     -->

    <!-- Encoder values practical
          <damping>150</damping>  
          <friction>0.6</friction>

     -->

    <!-- RIGHT -->
    <joint name="wheelset_right_revolute_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheelset_right</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-2.007</lower>
          <upper>2.007</upper>
        </limit>
        <dynamics>
          <damping>50</damping>  
          <friction>0.6</friction>
        </dynamics>
      </axis>
    </joint>


    <!-- REAR RIGHT -->
    <joint name="wheelset_rear_right_revolute_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheelset_rear_right</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-2.007</lower>
          <upper>2.007</upper>
        </limit>
        <dynamics>
          <damping>50</damping>  
          <friction>0.6</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- FRONT LEFT --> 
    <joint name="wheelset_left_revolute_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheelset_left</child>
      
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-2.007</lower>
          <upper>2.007</upper>
        </limit>
        <dynamics>
          <damping>50</damping>  
          <friction>0.6</friction>
        </dynamics>
      </axis>
    </joint>

    
    <link name="diff_drive/lidar_link">
        <pose>-0.65 0.05 1 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000166667</ixx>
            <iyy>0.000166667</iyy>
            <izz>0.000166667</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
        </visual>
        <sensor name='gpu_lidar' type='gpu_lidar'>
          <pose>0 0 0 0 0 0</pose>
          <topic>scan</topic>
           <gz_frame_id>diff_drive/lidar_link</gz_frame_id>
          <update_rate>10</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>640</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle> 
                <max_angle>3.14159</max_angle> 
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0.0</min_angle>
                <max_angle>0.0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.08</min>
              <max>10.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
          <visualize>true</visualize>
        </sensor>
    </link>

    <joint name='lidar_joint_loc' type='fixed'>
        <parent>base_link</parent>
        <child>diff_drive/lidar_link</child>
    </joint>



