<?xml version="1.0" ?>
<sdf version="1.8">
    <model name='nipper'>

      <!-- base_link just a rectangle -->
      <!-- <mass>200</mass>   -->
      
      <link name='base_link'>
      <pose>-1.15 0.05 -0.10 0 -0 0</pose>
      <inertial>
          <mass>305</mass>
          <inertia>
            <ixx>3.82</ixx>
            <iyy>6.73</iyy>
            <izz>10.42</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name='visual_base_link'>
          <geometry>
            <box>
              <size>1.5 0.6 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 1.0 1</ambient>
            <diffuse>0.5 0.5 1.0 1</diffuse>
            <specular>0.0 0.0 1.0 1</specular>
          </material>
        </visual>
