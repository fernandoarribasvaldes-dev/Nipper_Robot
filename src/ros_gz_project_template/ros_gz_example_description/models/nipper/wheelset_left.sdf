    <!-- Left -->
    <joint name="wheelset_left_revolute_joint" type="revolute">
      <parent>base_link_3</parent>
      <child>wheelset_left</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-2.007</lower>
          <upper>2.007</upper>
        </limit>
        <dynamics>
          <damping>40</damping>  
          <friction>0.6</friction>
        </dynamics>
      </axis>
    </joint>

