    <model name='wall_1'>
      <static>true</static>
      <pose>0 9.5 0 0 0 1.57</pose><!--pose relative to the world-->
      <link name='box'>
          <pose/>
          <visual name='visual'>
              <geometry>
                  <box>
                      <size>1 20.0 4.0</size>
                  </box>
              </geometry>
              <!--let's add color to our link-->
              <material>
                  <ambient>0.8 0.5 0.3 1</ambient>    <!-- Light brown ambient color -->
                  <diffuse>0.8 0.5 0.3 1</diffuse>    <!-- Light brown diffuse color -->
                  <specular>0.5 0.3 0.2 1</specular>  <!-- Lighter brown specular color -->
              </material>
          </visual>
          <collision name='collision'>
              <geometry>
                  <box>
                      <size>1 20.0 4.0</size>
                  </box>
              </geometry>
          </collision>

          <sensor name='sensor_contact' type='contact'>
              <contact>
                  <collision>collision</collision>
              </contact>
          </sensor>
      </link>

      <plugin filename="libignition-gazebo-touchplugin-system.so"
          name="ignition::gazebo::systems::TouchPlugin">
          <target>nipper</target>
          <namespace>wall</namespace>
          <time>0.001</time>
          <enabled>true</enabled>
      </plugin>

  </model>



  <model name='wall_2'>
      <static>true</static>
      <pose>0 -9.5 0 0 0 1.57</pose><!--pose relative to the world-->
      <link name='box'>
          <pose/>
          <visual name='visual'>
              <geometry>
                  <box>
                      <size>1 20.0 4.0</size>
                  </box>
              </geometry>
              <!--let's add color to our link-->
              <material>
                  <ambient>0.8 0.5 0.3 1</ambient>    <!-- Light brown ambient color -->
                  <diffuse>0.8 0.5 0.3 1</diffuse>    <!-- Light brown diffuse color -->
                  <specular>0.5 0.3 0.2 1</specular>  <!-- Lighter brown specular color -->
              </material>
          </visual>
          <collision name='collision'>
              <geometry>
                  <box>
                      <size>1 20.0 4.0</size>
                  </box>
              </geometry>
          </collision>

          <sensor name='sensor_contact' type='contact'>
              <contact>
                  <collision>collision</collision>
              </contact>
          </sensor>
      </link>

      <plugin filename="libignition-gazebo-touchplugin-system.so"
          name="ignition::gazebo::systems::TouchPlugin">
          <target>nipper</target>
          <namespace>wall</namespace>
          <time>0.001</time>
          <enabled>true</enabled>
      </plugin>

  </model>


   <model name='wall_3'>
      <static>true</static>
      <pose>9.5 0 0 0 0 0</pose><!--pose relative to the world-->
      <link name='box'>
          <pose/>
          <visual name='visual'>
              <geometry>
                  <box>
                      <size>1 18.0 4.0</size>
                  </box>
              </geometry>
              <!--let's add color to our link-->
              <material>
                  <ambient>0.8 0.5 0.3 1</ambient>    <!-- Light brown ambient color -->
                  <diffuse>0.8 0.5 0.3 1</diffuse>    <!-- Light brown diffuse color -->
                  <specular>0.5 0.3 0.2 1</specular>  <!-- Lighter brown specular color -->
              </material>
          </visual>
          <collision name='collision'>
              <geometry>
                  <box>
                      <size>1 18.0 2.0</size>
                  </box>
              </geometry>
          </collision>

          <sensor name='sensor_contact' type='contact'>
              <contact>
                  <collision>collision</collision>
