      </plugin>

  </model>


  <model name='wall_4'>
      <static>true</static>
      <pose>-9.5 0 0 0 0 0</pose><!--pose relative to the world-->
      <link name='box'>
          <pose/>
          <visual name='visual'>
              <geometry>
                  <box>
                      <size>1 18.0 4.0</size>
                  </box>
              </geometry>
              <!--let's add color to our link-->
              <material>
                  <ambient>0.8 0.5 0.3 1</ambient>    <!-- Light brown ambient color -->
                  <diffuse>0.8 0.5 0.3 1</diffuse>    <!-- Light brown diffuse color -->
                  <specular>0.5 0.3 0.2 1</specular>  <!-- Lighter brown specular color -->
              </material>
          </visual>
          <collision name='collision'>
              <geometry>
                  <box>
